# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git أبدًا.
# Copy to .env and fill in. Never commit .env.

# قاعدة بيانات التشغيل/التطوير (منفصلة عن قاعدة الاختبار)
DATABASE_URL=postgres://pamper:CHANGE_ME@localhost:5432/pamper_dev

# قاعدة بيانات الاختبارات الآلية فقط — تُمسح أثناء الاختبار
TEST_DATABASE_URL=postgres://pamper:CHANGE_ME@localhost:5432/pamper_test

# الرابط العام للتطبيق (يُستخدم في روابط تفعيل الحسابات)
APP_BASE_URL=http://localhost:3000

# development | production
APP_ENV=development

# Google Maps Routes API (اختياري). بدونها يُستخدم التقدير اليدوي لوقت الطريق.
# راجع docs/INTEGRATIONS.ar.md — قيّد المفتاح على Routes API وعنوان الخادم.
GOOGLE_MAPS_API_KEY=

# إشعارات الجوال (Web Push) — تُولَّد مرة واحدة: npm run push:keys
# بدونها تعمل الإشعارات داخل التطبيق فقط.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# خريطة Google داخل الحجز (Maps JavaScript + Geocoding) — مفتاح منفصل مقيّد بالدومين. اختياري.
GOOGLE_MAPS_BROWSER_KEY=

# Paymob (مدى، Apple Pay، STC Pay) — على الخادم فقط. اختياري؛ بدونها تبقى الروابط غير مفعلة.
# راجع docs/INTEGRATIONS.ar.md
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# مثال: card:111,apple_pay:222,stc_pay:333
PAYMOB_INTEGRATIONS=
PAYMOB_BASE_URL=

# تشغيل العامل الخلفي داخل خادم التطبيق (استضافات العملية الواحدة مثل Hostinger)
RUN_WORKER_IN_APP=

# تطبيق تحديثات قاعدة البيانات تلقائيًا عند بدء التطبيق (افتراضيًا مفعّل). ضع 0 لإيقافه.
MIGRATE_ON_START=
