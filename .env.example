# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git أبدًا.
# Copy to .env and fill in. Never commit .env.

# قاعدة بيانات التشغيل/التطوير (منفصلة عن قاعدة الاختبار)
DATABASE_URL=postgres://pamper:CHANGE_ME@localhost:5432/pamper_dev

# قاعدة بيانات الاختبارات الآلية فقط — تُمسح أثناء الاختبار
TEST_DATABASE_URL=postgres://pamper:CHANGE_ME@localhost:5432/pamper_test

# الرابط العام للتطبيق (يُستخدم في روابط تفعيل الحسابات)
APP_BASE_URL=http://localhost:3000

# development | production
APP_ENV=development

# Google Maps Routes API (اختياري). بدونها يُستخدم التقدير اليدوي لوقت الطريق.
# راجع docs/INTEGRATIONS.ar.md — قيّد المفتاح على Routes API وعنوان الخادم.
GOOGLE_MAPS_API_KEY=

# إشعارات الجوال (Web Push) — تُولَّد مرة واحدة: npm run push:keys
# بدونها تعمل الإشعارات داخل التطبيق فقط.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
