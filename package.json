{
  "name": "pamper-me-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:host": "tsx --conditions=react-server scripts/migrate.ts && next start",
    "lint": "tsc --noEmit",
    "test": "npm run db:migrate:test --silent && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "owner:invite": "tsx --conditions=react-server scripts/create-invite.ts",
    "account:create": "tsx --conditions=react-server scripts/create-account.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "db:migrate:test": "tsx --conditions=react-server scripts/migrate.ts --test",
    "icons": "tsx scripts/icons.ts",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@next/swc-wasm-nodejs": "16.3.6"
  }
}
