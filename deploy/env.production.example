# Copy to .env on the SERVER only (never into Git). Fill every CHANGE_ME.
# انسخه إلى ‎.env‎ على الخادم فقط، واملأ كل CHANGE_ME.

# The domain pointing to this server, without https:// (e.g. app.pamperme.sa)
DOMAIN=CHANGE_ME

# Long random database password (e.g. output of: openssl rand -base64 32)
POSTGRES_PASSWORD=CHANGE_ME

# Optional integrations — leave empty until ready
GOOGLE_MAPS_API_KEY=
